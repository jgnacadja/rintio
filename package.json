{
  "name": "rintio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prebuild": "nuxt cleanup",
    "build": "nuxt build",
    "dev": "cross-env NUXT_ENV_TEST=true nuxt dev",
    "dev:debug": "cross-env NUXT_ENV_TEST=false nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "npx eslint",
    "format": "npx prettier --config .prettierrc  . --ignore-path .gitignore --ignore-path .prettierignore --check",
    "format:fix": "npx prettier --config .prettierrc  . --ignore-path .gitignore --ignore-path .prettierignore --write",
    "test": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "precommit": "lint-staged",
    "commit": "cz"
  },
  "dependencies": {
    "@contentful/rich-text-html-renderer": "^17.2.3",
    "@fortawesome/fontawesome-free": "^6.7.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@getbrevo/brevo": "^5.0.4",
    "@nuxt/image": "^1.9.0",
    "@nuxt/scripts": "^0.11.13",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/i18n": "^9.5.6",
    "@nuxtjs/robots": "^5.0.0",
    "@nuxtjs/seo": "^3.2.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.16",
    "@vercel/analytics": "^2.0.1",
    "@vueuse/core": "^10.0.0",
    "contentful": "^11.12.7",
    "dayjs": "^1.11.13",
    "embla-carousel-vue": "^8.6.0",
    "gsap": "^3.15.0",
    "marked": "^14.1.4",
    "nuxt": "3.21.10",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.2.5",
    "@fortawesome/free-brands-svg-icons": "^6.7.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@nuxt/test-utils": "^3.19.2",
    "@nuxtjs/tailwindcss": "^6.13.1",
    "@playwright/test": "^1.54.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^8.0.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^24.0.13",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/eslint-plugin": "^1.1.7",
    "@vue/compiler-sfc": "^3.3.4",
    "@vue/eslint-config-typescript": "^14.1.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-nuxt": "^1.0.1",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-sonarjs": "^2.0.4",
    "eslint-plugin-vue": "^9.29.0",
    "globals": "^15.12.0",
    "husky": "^9.0.11",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.81.0",
    "semantic-release": "19.0.5",
    "ts-loader": "8.3.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^3.2.7",
    "vitest-sonar-reporter": "^2.0.0",
    "vue-eslint-parser": "^9.4.3"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yml,cjs}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "yarn@1.22.22"
}
